  <legend x="216" y="32">TimeMon: activité du CPU</legend>
  <legend x="292" y="32">Activité réseau</legend>
  <legend x="340" y="38">Mise à jour du système</legend>
  <legend x="390" y="42">Notification d'événements familiaux</legend>
  <legend x="460" y="46">Stockage et montage des disques amovibles</legend>
</legendfig>
</section>

</section>
